{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard"
  ],
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "branchConcurrentLimit": 0,
  "mode": "full",
  "commitMessageLowerCase": "auto",
  "semanticCommits": "enabled",
  "flux": {
    "managerFilePatterns": [
      "/^.*flux\\.yaml$/"
    ]
  },
  "packageRules": [
    {
      "matchManagers": [
        "github-actions",
        "flux"
      ],
      "groupName": "all-ci-dependencies",
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch"
      ]
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "sigstore/cosign-installer"
      ],
      "enabled": false
    },
    {
      "matchFileNames": [
        "devbox.json"
      ],
      "groupName": "devbox-toolchain"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update crdoc installed by the Devbox init hook",
      "managerFilePatterns": [
        "/^devbox\\.json$/"
      ],
      "matchStrings": [
        "\"CRDOC_VERSION\"\\s*:\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "fybrik.io/crdoc",
      "datasourceTemplate": "gomod",
      "versioningTemplate": "go"
    },
    {
      "customType": "regex",
      "description": "Update the source license header CLI",
      "managerFilePatterns": [
        "/^devbox\\.json$/"
      ],
      "matchStrings": [
        "\"NWA_VERSION\"\\s*:\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "B1NARY-GR0UP/nwa",
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "semver"
    }
  ],
  "baseBranchPatterns": [
    "main"
  ],
  "devbox": {
    "enabled": true,
    "lockFileMaintenance": {
      "enabled": true
    }
  }
}
